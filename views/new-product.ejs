<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeaStock | New Product</title>
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/new-product.css" />
</head>
<body>
    <%- include("partials/header.ejs") %>

    <main class="new-product-page">
        <h1>Add new product</h1>

        <form method="POST" action="/products/new">
            <label for="name">Tea name:</label>
            <input type="text" name="name" id="name" required placeholder="Earl Grey">
            
            <label for="description">Description:</label>
            <textarea name="description" id="description" rows="4" placeholder="Write something about your tea here..."></textarea>

            <label for="price">Price: (in $)</label>
            <input type="number" name="price" id="price" min="0" step="0.01" required>

            <label for="stock">Stock:</label>
            <input type="number" name="stock" id="stock" min="0" required>

            <label for="category">Choose a tea category:</label>
            <select name="category_id" id="category" required>
                <option value="">--Please choose a tea category--</option>

                <% categories.forEach((category) => { %>
                    <option value=<%= category.id %>><%= category.name %></option>
                <% }) %>
            </select>

            <label for="origin">Choose a tea origin:</label>
            <select name="origin_id" id="origin" required>
                <option value="">--Please choose a tea origin--</option>

                <% origins.forEach((origin) => { %>
                    <option value=<%= origin.id %>><%= origin.country %> - <%= origin.region %></option>
                <% }) %>
            </select>

            <button type="submit">Add product</button>
        </form>
    </main>

    <%- include("partials/footer.ejs") %>
</body>
</html>