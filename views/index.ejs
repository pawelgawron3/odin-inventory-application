<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TeaStock</title>
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/index.css">
  </head>
  <body>
    <header class="header">
      <div class="logo"></div>

      <div class="links">
        <span class="categoriesSpan">Categories</span>
        <span class="allProductsSpan">All products</span>
      </div>

      <div class="addProductBtn">
        <button type="button">+ Add product</button>
      </div>
    </header>

    <h1>Categories</h1>
    <p>Browse inventory by category</p>

    <ul class="categories">
        <% rows.forEach((category) => { %>
            <li class="category">
              <a href="/categories/<%= category.id %>">
                <h2><%= category.name %></h2>
                <p><%= category.description %></p>
              </a>
            </li>
        <% })%> 
    </ul>
  </body>
</html>
