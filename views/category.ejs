<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TeaStock | <%= category.name %></title>
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/category.css" />
  </head>
  <body>
    <%- include("partials/header.ejs") %>

      <main class="category-page">
        <div class="category-header">
          <h2><%= category.name %></h2>
          <p><%= category.description %></p>
        </div>

        <div class="table-wrapper">
          <table class="tea-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Country</th>
              </tr>
            </thead>

            <tbody>
              <% teas.forEach((tea) => { %>
                <tr>
                  <td>
                  <a href="/products/<%= tea.id %>"><%= tea.name %></a>
                  </td>
                  <td><%= tea.price %>$</td>
                  <td><%= tea.stock %></td>
                  <td><%= tea.country %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </main>

    <%- include("partials/footer.ejs") %>
  </body>
</html>
