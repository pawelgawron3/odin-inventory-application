<header class="header">
  <div class="logo">
    <a href="/">
      <span class="logo-icon">🍵</span>
      <span class="logo-text">TeaStock</span>
    </a>
  </div>

  <div class="links">
    <a href="/" class="nav-link <%= currentPath === "/" || currentPath.startsWith("/categories") ? "active" : "" %>">Categories</a>
    <a href="/products" class="nav-link <%= currentPath.startsWith("/products") ? "active" : "" %>">All products</a>
    <a href="/origins" class="nav-link <%= currentPath.startsWith("/origins") ? "active" : "" %>">Origins</a>
  </div>

  <a class="addProduct" href="/products/new">+ Add product</a>
</header>
